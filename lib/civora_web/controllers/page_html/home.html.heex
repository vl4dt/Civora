<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section class="flex flex-col gap-5 border-b border-base-300 pb-8 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-medium text-primary">Base operativa</p>
      <h1 class="mt-2 text-3xl font-semibold">Panel de proyectos</h1>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-base-content/65">
        Seguimiento interno de proyectos de arquitectura y construccion.
      </p>
    </div>
    <div class="flex items-center gap-2 text-sm text-base-content/65">
      <span class="size-2 bg-success" aria-hidden="true"></span> Sesion activa
    </div>
  </section>

  <section class="grid min-h-80 place-items-center border-b border-base-300 py-16 text-center">
    <div class="max-w-md">
      <.icon name="hero-building-office-2" class="mx-auto size-10 text-base-content/35" />
      <h2 class="mt-4 text-lg font-semibold">Sin proyectos asignados</h2>
      <p class="mt-2 text-sm leading-6 text-base-content/60">
        Los proyectos disponibles para tu cuenta apareceran aqui.
      </p>
    </div>
  </section>
</Layouts.app>
